{
  "name": "scratch-vibe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scratch:sync": "node scripts/sync-scratch-editor.mjs",
    "predev": "npm run scratch:sync",
    "dev": "concurrently -k -n server,web \"npm run server:dev\" \"vite --host 127.0.0.1\"",
    "server:dev": "tsx watch server/index.ts",
    "prebuild": "npm run scratch:sync",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@scratch/scratch-gui-standalone": "13.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
