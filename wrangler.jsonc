{
  "name": "scratch-vibe",
  "main": "worker/index.ts",
  "account_id": "aeac7a4c153aee0be799bea1169887ef",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Share links: .sb3 files stored for 30 days.
  "kv_namespaces": [
    { "binding": "SHARES", "id": "f7335d231fa5427cb697d914a7e76fad" }
  ],
  // Per-IP limits so the API cannot be used as an open relay.
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 90, "period": 60 } },
    { "name": "MEDIA_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "SHARE_LIMITER", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ]
}
